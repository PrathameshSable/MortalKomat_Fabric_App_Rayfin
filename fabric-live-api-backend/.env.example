# ─────────────────────────────────────────────────────────────────────────────
# fabric-live-api-backend — environment template
# Copy to `.env` and fill in YOUR values. `.env` is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# CORS — the origin the Fabric (Rayfin) app calls this backend from.
# The app renders inside the Fabric portal, so allow that origin.
# Comma-separated list; supports the Fabric portal + your local dev server.
CORS_ALLOWED_ORIGINS=https://app.fabric.microsoft.com,https://msit.fabric.microsoft.com,http://localhost:5173

# ── External live REST API (the source you ingest) ───────────────────────────
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_PATH=/v1/readings
EXTERNAL_API_KEY=replace-me
# How often (ms) the poller hits the external API. Ignored if you only use webhooks.
INGEST_POLL_INTERVAL_MS=2000
# Set to "false" to disable the poller (e.g. when the external API only pushes webhooks).
INGEST_POLL_ENABLED=true

# ── Fabric Eventstream (custom-app source — Event Hubs compatible) ────────────
# Copy this from your Eventstream's custom-app source → Keys tab.
# Looks like: Endpoint=sb://eventstream-xxxx.servicebus.windows.net/;SharedAccessKeyName=key_xxxx;SharedAccessKey=xxxx;EntityPath=es_xxxx
EVENTSTREAM_CONNECTION_STRING=replace-me
# Max events buffered before a flush, and max time (ms) before a partial batch is flushed.
EVENTSTREAM_BATCH_MAX_SIZE=100
EVENTSTREAM_BATCH_MAX_WAIT_MS=1000

# ── Fabric Eventhouse / KQL (optional: direct write-back + read API) ──────────
# Only needed if you use the /api/query read endpoint or direct KQL write-back.
# Query URI looks like: https://<cluster>.kusto.fabric.microsoft.com
KUSTO_QUERY_URI=
KUSTO_DATABASE=
KUSTO_TABLE=LiveEvents
# Service principal (Microsoft Entra ID app registration) used to auth to Kusto.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
