# Copy to `fabric.yaml` and fill in YOUR semantic model's ids.
# Both GUIDs are visible in the model's URL in the Fabric portal:
#   .../groups/<workspaceId>/datasets/<itemId>/...
#
# The query wrappers in queries/*.ts reference the alias `bankModel`.
activeProfile: default
profiles:
  default:
    semanticModels:
      bankModel:
        workspaceId: 00000000-0000-0000-0000-000000000000
        itemId: 00000000-0000-0000-0000-000000000000
