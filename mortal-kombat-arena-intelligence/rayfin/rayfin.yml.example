# Copy this file to `rayfin.yml` before running `npx rayfin up`.
# Your deployed hosting URL is added to allowedRedirectUris automatically
# after the first deploy.
id: mortal-kombat-arena-intelligence
name: mortal-kombat-arena-intelligence
version: 1.0.0
services:
  auth:
    enabled: true
    fabric:
      enabled: true
    allowedRedirectUris:
      - http://localhost:5173
  data:
    enabled: false
  storage:
    enabled: false
  staticHosting:
    enabled: true
    folder: dist
    buildCommand: npm run build:fabric
    indexDocument: index.html
  functions:
    enabled: false
