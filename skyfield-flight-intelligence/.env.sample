# Loaded by `vite build --mode sample` (npm run build:fabric:sample).
# Forces the animated sample fleet even when embedded in the Fabric portal —
# use this for an initial "shell" publish before the live data pipeline exists.
VITE_FORCE_SAMPLE=true

# "Ask Skyfield" chat overlay. Set to your Copilot Studio agent's Direct Line
# token endpoint (Copilot Studio → Settings → Channels → Token Endpoint). The
# agent should have a Fabric data agent connected. See COPILOT_DATA_AGENT_SETUP.md.
# Leave unset to hide/disable the assistant.
# VITE_COPILOT_TOKEN_ENDPOINT=https://<region>.directline.botframework.com/v3/directline/tokens/generate
