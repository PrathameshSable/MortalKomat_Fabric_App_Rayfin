{
  "name": "skyfield-flight-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "A cinematic 3D live flight-intelligence app: a react-three-fiber globe of real aircraft, designed for the Microsoft Fabric / Rayfin 1280x720 canvas and fed by the fabric-live-api-backend (OpenSky → Eventhouse).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fabric": "fabric-app-data generate -o src/fabric.generated.ts && tsc --noEmit && vite build",
    "build:fabric:sample": "tsc --noEmit && vite build --mode sample",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@microsoft/fabric-app-data": "^1.0.0",
    "@microsoft/fabric-app-data-embed-client": "^1.0.0",
    "@microsoft/fabric-app-data-proxy": "^1.0.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@microsoft/fabric-app-data-cli": "^1.0.0",
    "@microsoft/rayfin-cli": "^1.33.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
