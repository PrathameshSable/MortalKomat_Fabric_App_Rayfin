// Live aircraft set for the globe. Read by createFabricFlightProvider().
// Column order MUST match rowToFlight() in src/data/fabric/fabricProvider.ts.
// Build the semantic model over the Eventhouse LatestFlights() snapshot so this
// returns only recently-seen aircraft.
EVALUATE
SELECTCOLUMNS(
    Flights,
    "icao24", Flights[icao24],
    "callsign", Flights[callsign],
    "originCountry", Flights[originCountry],
    "longitude", Flights[longitude],
    "latitude", Flights[latitude],
    "geoAltitude", Flights[geoAltitude],
    "velocity", Flights[velocity],
    "heading", Flights[heading],
    "verticalRate", Flights[verticalRate],
    "onGround", Flights[onGround]
)
